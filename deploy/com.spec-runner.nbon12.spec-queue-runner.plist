<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.spec-runner.nbon12.spec-queue-runner</string>

  <!-- Fire one tick every 5 minutes; launchd is the only host-specific trigger (FR-052a). -->
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/docker</string>
    <string>run</string><string>--rm</string><string>--platform</string><string>linux/arm64</string>
    <string>-v</string><string>/Users/nicholasbonilla/.config/spec-runner/spec-queue-runner.pat:/run/secrets/github_pat:ro</string>
    <string>-v</string><string>sr-self-home:/home/runner</string>
    <string>-v</string><string>/Users/nicholasbonilla/RiderProjects/spec-queue-runner/deploy/spec-queue-runner.toml:/etc/spec-runner/config.toml:ro</string>
    <string>spec-runner:latest</string>
    <string>tick</string><string>/etc/spec-runner/config.toml</string>
  </array>

  <!-- launchd runs with a bare environment; pin PATH and the Docker Desktop socket explicitly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
    <key>DOCKER_HOST</key><string>unix:///Users/nicholasbonilla/.docker/run/docker.sock</string>
  </dict>

  <key>StandardOutPath</key><string>/Users/nicholasbonilla/.config/spec-runner/scheduler.log</string>
  <key>StandardErrorPath</key><string>/Users/nicholasbonilla/.config/spec-runner/scheduler.log</string>
</dict>
</plist>
