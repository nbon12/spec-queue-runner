<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared test harness: fake claude recorder, fixture repos, in-memory GitHub.
       A library, not a test runner itself — the three suites reference it. -->
  <PropertyGroup>
    <RootNamespace>SpecRunner.TestKit</RootNamespace>
    <!-- A support library, not a test runner — keep `dotnet test` from trying to run it. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SpecRunner/SpecRunner.csproj" />
  </ItemGroup>

</Project>
